logs/
runs/
tmp/
temp/
cache/
outputs/
features/
preprocessed/
preprocess/
2-name2text.txt
6-name2semantic.tsv
*.npy
*.npz
*.pt.tmp
*.pth.tmp
*.ckpt.tmp

# GPT-SoVITS working tree artifacts — do not vendor upstream clone here
GPT-SoVITS/
GPT_SoVITS/
pretrained_models/
SoVITS_weights/
GPT_weights/
SoVITS_weights_v2/
GPT_weights_v2/
