# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/

# Secrets / local config
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.token
secrets/
private/

# Raw/private voice data — NEVER commit by default
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.webm
