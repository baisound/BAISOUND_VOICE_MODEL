
# Git LFS: model/checkpoint binaries
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
# Owner-approved public demo audio only
samples/public/*.wav filter=lfs diff=lfs merge=lfs -text
# Normalize text
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.cff text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
